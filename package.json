{
  "name": "house-dojo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "supabase test db",
    "db:start": "supabase db start",
    "types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start -x storage-api,imgproxy,studio,edge-runtime,logflare,vector,supavisor"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "supabase": "^3.2.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
